generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  companies    Company[]
  applications Application[]
}

model Company {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  website String?
  industry String?
  size String?
  notes String?
  applications Application[]
  jobPostings JobPosting[]
  contacts Contact[]
  createdAt DateTime @default(now())
}

model Contact {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  name String
  role String?
  email String?
  linkedin String?
  notes String?
}

model JobPosting {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  title String
  url String?
  source String?
  location String?
  remotePolicy String?
  salaryMin Int?
  salaryMax Int?
  techStack String[]
  description String? // raw job text, feeds future AI extraction/fit scoring
  postedAt DateTime?
  application Application?
  createdAt DateTime @default(now())
}

model Application {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostingId String? @unique
  jobPosting JobPosting? @relation(fields: [jobPostingId], references: [id])
  companyId String
  company Company @relation(fields: [companyId], references: [id])
  currentStatus ApplicationStatus @default(SAVED)
  appliedAt DateTime?
  lastInteractionAt DateTime?
  statusEvents StatusEvent[]
  formAnswers FormAnswer[]
  createdAt DateTime @default(now())
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  TECHNICAL_INTERVIEW
  FINAL_ROUND
  OFFER
  REJECTED
  WITHDRAWN
  GHOSTED
}

enum ActionType {
  EMAIL_SENT
  EMAIL_RECEIVED
  PHONE_CALL
  VIDEO_CALL
  TAKE_HOME_SUBMITTED
  FOLLOW_UP_SENT
  OFFER_RECEIVED
  OTHER
}

model StatusEvent {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id])
  status ApplicationStatus
  actionType String?
  comment String?
  occurredAt DateTime @default(now())
}

model FormAnswer {
  id String @id @default(cuid())
  applicationId String
  application Application @relation(fields: [applicationId], references: [id])
  question String
  answer String
  createdAt DateTime @default(now())
} 