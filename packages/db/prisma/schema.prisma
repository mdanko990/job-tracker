generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  applications  Application[]
  companies     Company[]
  sessions      Session[]
  mobileSessions MobileSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MobileSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  userId       String
  applications Application[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts     Contact[]
}

model Contact {
  id        String  @id @default(cuid())
  companyId String
  name      String
  role      String?
  email     String?
  linkedin  String?
  notes     String?
  isConnected   Boolean  @default(false)
  isMessaged    Boolean  @default(false)
  company   Company @relation(fields: [companyId], references: [id])
}

model Application {
  id                String            @id @default(cuid())
  companyId         String
  currentStatus     ApplicationStatus @default(SAVED)
  appliedAt         DateTime?
  lastInteractionAt DateTime?
  createdAt         DateTime          @default(now())
  userId            String
  description       String?
  location          String?
  remotePolicy      String?
  salaryMax         Int?
  salaryMin         Int?
  techStack         String[]
  title             String
  url               String?
  company           Company           @relation(fields: [companyId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  formAnswers       FormAnswer[]
  statusEvents      StatusEvent[]
}

model StatusEvent {
  id            String            @id @default(cuid())
  applicationId String
  status        ApplicationStatus
  actionType    String?
  comment       String?
  occurredAt    DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model FormAnswer {
  id            String      @id @default(cuid())
  applicationId String
  question      String
  answer        String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

enum ApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  TECHNICAL_INTERVIEW
  FINAL_ROUND
  OFFER
  REJECTED
  WITHDRAWN
  GHOSTED
}

enum ActionType {
  EMAIL_SENT
  EMAIL_RECEIVED
  PHONE_CALL
  VIDEO_CALL
  TAKE_HOME_SUBMITTED
  FOLLOW_UP_SENT
  OFFER_RECEIVED
  OTHER
}
