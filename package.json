{
  "name": "job-tracker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@job-tracker/web",
    "dev:mobile": "npm run start --tunnel --workspace=@job-tracker/mobile",
    "db:generate": "npm run generate --workspace=@job-tracker/db",
    "db:migrate": "npm run migrate --workspace=@job-tracker/db",
    "build:web": "npm run build --workspace=@job-tracker/web",
    "test": "npm run test:unit --workspace=@job-tracker/web",
    "lint": "npm run lint --workspaces",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  }
}
